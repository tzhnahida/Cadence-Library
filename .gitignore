# OrCAD & Allegro Combined GitIgnore

# 1. 排除所有备份文件
*.DBK*
*.[0-9][0-9]*
*.log*
*.bak
*.sav
*.asv

# 2. 排除日志与交互文件
*.jrl
*.jrl,*
*.tag
*.lck
*.OBK
*.OLBlck
*.txt
# 注意：如果你的元件清单(BOM)是txt格式，请改用 !BOM.txt 来排除过滤

# 3. 排除仿真与输出文件夹
/Simulation/
/Gerber/
/Output/
/Backup/
/temp/
signoise.run/

# 4. 排除操作系统杂项
.DS_Store
Thumbs.db
desktop.ini

# 5. 必须保留的核心设计文件 (白名单参考)
# *.DSN (原理图)
# *.OPJ (项目)
# *.OLB (原理图库)
# *.BRD (PCB布局)
# *.DRA (封装源码)
# *.PSM (封装库)
# 本地运行副本：含真实 API key，绝不入库
# （模板见 LyncLibrarySynchronizer/config.toml，其 api_key 为空占位）
/config.toml

# 6. 大型可再生产物（2026-10-24 起）：OldLibrary 不进 git
#    OldLibrary 是本地备份（数百 MB 二进制）
#    3D STEP 模型 2026-10-25 起入库（同名去重后 ~135 MB），封装 .dra 只存 STEP 文件名，
#    由 steppath 解析
/OldLibrary/

# 7. 生成物与备份（2026-10-25 起）
#    _out: Allegro 临时输出（.brd / devices / 日志）
#    stepFacetFiles4Map: Ultra Librarian 导入器解出来的 111 MB 临时面片目录
#    CIS 备份: 每次写库自动生成的 12 MB .mdb 副本，不入库
/_out/
/Allegro/Footprints/stepFacetFiles4Map/
/CIS/*.ldb
/CIS/*.bak_*


# 备份文件（带时间戳后缀）
*.bak_*
